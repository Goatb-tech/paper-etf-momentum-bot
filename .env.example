# Create a distinct paper-only API key in Alpaca's dashboard. Never use a live key here.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=sip

# Risk controls. Decimal values: 0.0025 = 0.25%.
BOT_RISK_PER_TRADE=0.0025
BOT_HARD_RISK_CAP=0.005
BOT_DAILY_LOSS_LIMIT=0.01
BOT_MAX_POSITIONS=4
BOT_MAX_POSITION_ALLOCATION=0.25
BOT_STOP_ATR_MULTIPLE=2.0
BOT_REWARD_TO_RISK=3.0

# Optional: a Discord- or Slack-compatible incoming webhook for alerts.
BOT_ALERT_WEBHOOK_URL=
BOT_STATE_PATH=data/state.json

